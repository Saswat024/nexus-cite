# Groq LLM API Key (fast streaming with openai/gpt-oss-120b and qwen/qwen3.8-27b)
GROQ_API_KEY=your_groq_api_key

# Hugging Face API Token (Qwen/Qwen3-Embedding-8B dense vectors)
HUGGINGFACE_API_KEY=your_hf_token

# Qdrant Cloud Vector Database (hybrid dense + sparse vector search)
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nexus_cite
